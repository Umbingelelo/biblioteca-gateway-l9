# biblioteca-gateway: copia este archivo a .env y rellenalo con TU ficha. El .env no se sube a GitHub.
#
# COGNITO_ISSUER y COGNITO_CLIENT_ID salen de tu ficha de Cognito (L3): el issuer de tu user pool y el
# id de tu app client. No son secretos, pero tienen que ser los de TU user pool.
COGNITO_ISSUER=https://cognito-idp.us-east-1.amazonaws.com/us-east-1_XXXXXXXXX
COGNITO_CLIENT_ID=

# A donde enruta el gateway. Fuera de Docker son los puertos de siempre; dentro, biblioteca-plataforma
# los reemplaza por los nombres de servicio del compose.
BFF_URL=http://localhost:3000
LIBROS_URL=http://localhost:3001
PRESTAMOS_URL=http://localhost:3002
